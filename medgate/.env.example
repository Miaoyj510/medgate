# ===== MedGate 环境配置 =====
# 复制为 .env 后按需修改；.env 不入版本库。

# --- 服务 ---
APP_ENV=dev
LOG_LEVEL=INFO
API_PORT=8080

# --- 存储 ---
# 开发态默认 SQLite（免安装）；compose 内使用 PostgreSQL
DATABASE_URL=sqlite:///./data/medgate.db
# 生产形态：PostgreSQL 16 + pgvector，见 PRD 13.8.3
# DATABASE_URL=postgresql+psycopg://medgate:medgate@db:5432/medgate
REDIS_URL=
EMBEDDING_DIM=512

# --- 数据目录（目录/编码/规则种子）---
SEED_DIR=seed

# --- 大模型（仅用于要素抽取 / 归类 / 依据说明；判定在本地规则引擎）---
# 未配置 API Key 时自动进入 stub 模式，不外发数据
LLM_MODE=stub
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2
MINIMAX_TIMEOUT=20
MINIMAX_MAX_RETRIES=1
# 并发闸门（令牌桶）：同时在跑的大模型调用数
MAX_LLM_CONCURRENCY=2
# 单件业务件的大模型调用预算，超出即降级为「纯规则 + 人工」
LLM_CALL_BUDGET_PER_CASE=4
